{
  "name": "e2i-voip-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "dev:webpack": "next dev --webpack --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --coverage --passWithNoTests",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test:ci && npm run test:e2e",
    "security:audit": "npm audit --audit-level=high",
    "validate": "npm run lint && npm run type-check && npm run test:all && npm run security:audit && npm run build",
    "predeploy": "npm run validate",
    "analyze": "ANALYZE=true npm run build",
    "assets:brand": "node scripts/generate-brand-assets.mjs",
    "extract:blog": "cd scripts && npm run extract",
    "install:all": "npm install && cd scripts && npm install"
  },
  "dependencies": {
    "@hubspot/api-client": "^13.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "@playwright/test": "^1.54.2",
    "@radix-ui/react-dialog": "^1.0.4",
    "@radix-ui/react-select": "^1.2.2",
    "@radix-ui/react-slot": "^1.0.2",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "concurrently": "^8.2.2",
    "critters": "^0.0.23",
    "daisyui": "^5.0.50",
    "framer-motion": "^10.18.0",
    "lineicons-react": "^2.0.0",
    "next": "^16.3.1",
    "node-fetch": "^3.3.2",
    "posthog-js": "^1.372.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.5.2",
    "react-intersection-observer": "^9.16.0",
    "resend": "^6.20.0",
    "sanitize-html": "^2.17.7",
    "sonner": "^2.0.6",
    "tailwind-merge": "^1.14.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.22.4",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/sanitize-html": "^2.16.1",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.4.0",
    "shadcn": "^3.3.1",
    "tailwindcss": "^3.4.0",
    "ts-jest": "^29.4.1",
    "typescript": "^5.0.0"
  }
}
