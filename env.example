# Blog public — source unique HubSpot CMS API (Private App)
# HubSpot → Paramètres → Intégrations → Applications privées
# Scopes requis : cms.blog.read, cms.blog_posts.read
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token

# HubSpot OAuth admin (OPTIONNEL — uniquement pour /admin/hubspot)
# HUBSPOT_CLIENT_ID=your_hubspot_client_id
# HUBSPOT_CLIENT_SECRET=your_hubspot_client_secret
# HUBSPOT_REDIRECT_URI=http://localhost:3000/api/hubspot/callback

# OpenAI (usage hors blog — assets marketing si besoin)
OPENAI_API_KEY=

# Tally Configuration
TALLY_API_KEY=your_tally_api_key

# Tawk.to Configuration
NEXT_PUBLIC_TAWK_TO_ID=688d3cc109ef001928d4773f
NEXT_PUBLIC_TAWK_TO_WIDGET_ID=1j1jrald3
NEXT_PUBLIC_TAWK_TO_ENABLED=false

# Resend — envoi des demandes du formulaire studio
# Domaine validé côté Resend : notifications.e2i-voip.com
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=studio@notifications.e2i-voip.com
STUDIO_EMAIL_TO=commerciaux@e2i-voip.com

# Resend — demandes d’exercice de droits RGPD (/exercer-mes-droits)
# Destinataire distinct de STUDIO_EMAIL_TO : une demande d’exercice de droits
# est soumise à un délai de réponse légal d’un mois et ne doit pas se noyer
# dans le flux commercial.
RGPD_EMAIL_TO=hello@e2i-voip.com

# Cloudflare Turnstile — protection anti-robot optionnelle du formulaire RGPD.
# Si TURNSTILE_SECRET_KEY est renseignée côté serveur, la route exige un jeton
# valide avant tout envoi d'email.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
# TURNSTILE_SECRET_KEY=your_turnstile_secret_key
